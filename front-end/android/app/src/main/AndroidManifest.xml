<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  
  <!-- === 網路與儲存權限 === -->
  <uses-permission android:name="android.permission.INTERNET"/>                    <!-- 網路連線權限：允許應用程式存取網際網路 -->
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>      <!-- 讀取外部儲存權限：允許讀取裝置儲存空間的檔案 -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>       <!-- 系統視窗權限：允許在其他應用程式上方顯示視窗 -->
  <uses-permission android:name="android.permission.VIBRATE"/>                   <!-- 震動權限：允許控制裝置震動器 -->
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>    <!-- 寫入外部儲存權限：允許在裝置儲存空間建立/修改檔案 -->
  
  <!-- === 位置權限 === -->
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />     <!-- 精確位置權限：允許取得精確的 GPS 位置資訊 -->

  <!-- === 音訊權限 === -->
  <uses-permission android:name="android.permission.RECORD_AUDIO" />             <!-- 錄音權限：允許使用麥克風進行音訊錄製 -->
  
 

  <!-- === 藍牙權限 === -->
  <uses-permission android:name="android.permission.BLUETOOTH" />                <!-- 藍牙權限：允許使用藍牙功能 -->
  <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />          <!-- 藍牙管理權限：允許管理藍牙設定和連接 -->
 
  <!-- === Android 12+ 藍牙權限 (API 31+) === -->
  <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />           <!-- 藍牙掃描權限：允許掃描附近的藍牙裝置 -->
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />        <!-- 藍牙連接權限：允許與藍牙裝置建立連接 -->

  <!-- === Android 13+ 媒體權限 (API 33+) === -->
  <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>         <!-- 讀取媒體圖片權限：允許存取裝置中的圖片檔案 -->
  <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"/>          <!-- 讀取媒體音訊權限：允許存取裝置中的音訊檔案 -->

  <!-- === 通知權限 === -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />       <!-- 通知權限：允許應用程式發送通知 (Android 13+ API 33+) -->


  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW"/>
      <category android:name="android.intent.category.BROWSABLE"/>
      <data android:scheme="https"/>
    </intent>
  </queries>
  <application 
    android:name=".MainApplication" 
    android:label="@string/app_name" 
    android:icon="@mipmap/ic_launcher" 
    android:roundIcon="@mipmap/ic_launcher_round" 
    android:allowBackup="true" 
    android:theme="@style/AppTheme" 
    android:supportsRtl="true"
    android:usesCleartextTraffic="true">
    <meta-data android:name="expo.modules.updates.ENABLED" android:value="false"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_CHECK_ON_LAUNCH" android:value="ALWAYS"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_LAUNCH_WAIT_MS" android:value="0"/>
    <activity android:name=".MainActivity" android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode" android:launchMode="singleTask" android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.App.SplashScreen" android:exported="true" android:screenOrientation="portrait">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="myapp"/>
        <data android:scheme="com.user1117.rnProject"/>
        <data android:scheme="exp+rnproject"/>
      </intent-filter>
    </activity>
  </application>
</manifest>