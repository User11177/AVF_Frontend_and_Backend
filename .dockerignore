# .dockerignore
# Docker 構建時要忽略的文件和目錄
# 專用於只打包後端 + SQL 的配置

# =================================
# 前端相關 - 完全排除
# =================================
front-end/
front-end/**
*.apk
*.ipa

# =================================
# 開發工具和配置文件
# =================================
.git/
.gitignore
README.md
.vscode/
.idea/
*.log

# =================================
# Python 相關忽略
# =================================
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
.Python
*.so
.coverage
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json

# =================================
# 虛擬環境
# =================================
venv/
env/
ENV/
.venv/
.env/

# =================================
# 臨時文件和快取
# =================================
*.tmp
*.temp
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# =================================
# 日誌文件 (運行時生成)
# =================================
back-end/logs/*.log

# =================================
# 上傳文件目錄 (運行時生成)
# =================================
back-end/uploads/

# =================================
# Nginx 配置 (已在伺服器端)
# =================================
nginx/

# =================================
# Docker 相關
# =================================
Dockerfile
docker-compose.yml
docker-compose.*.yml

# =================================
# 其他工具配置
# =================================
.dockerignore
check_ip.py

# =================================
# 保留的目錄和文件
# =================================
# back-end/        <- 保留（後端代碼）
# sql/             <- 保留（資料庫初始化）
#
# 確保構建時包含：
# - back-end/main.py
# - back-end/config.py  
# - back-end/requirements.txt
# - back-end/routers/
# - sql/init.sql
